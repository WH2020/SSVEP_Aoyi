# Preserve the committed CRLF bytes for Windows launchers in checkouts and ZIP archives.
# UTF-8 command scripts that change code page can be misparsed with LF-only lines.
*.cmd -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.bat -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
