<Window x:Class="Ssvep.Studio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Ssvep.Studio.App"
 Title="SSVEP 实验设计" Width="1280" Height="840" MinWidth="1000" MinHeight="680" Background="#F3F5F8"
 FontFamily="Microsoft YaHei UI" FontSize="14" Foreground="#18263A" WindowStartupLocation="Manual">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DDE7"/><Setter Property="Foreground" Value="#26364B"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#146C63"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Padding" Value="18,14"/><Setter Property="Background" Value="#1C3045"/><Setter Property="Foreground" Value="#F0F6FC"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CBD5E1"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="38"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid x:Name="WindowViewport" Background="#F3F5F8" SizeChanged="Viewport_SizeChanged">
 <Grid x:Name="LayoutRoot" Background="#F3F5F8">
  <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#13263A" Padding="22,30">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,30"><TextBlock Text="SSVEP" FontSize="29" FontWeight="Bold" Foreground="White"/><TextBlock Text="实验设计" Foreground="#AAC2D8" Margin="0,4,0,0"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="固定六目标实验" Foreground="#AAC2D8" FontSize="12"/><TextBlock Text="内容编辑 · 佩戴检查 · 在线识别" Foreground="#7995AE" FontSize="11" Margin="0,8,0,0"/></StackPanel>
    <StackPanel><Button x:Name="EditorNav" Content="01  刺激内容" Style="{StaticResource Nav}" Click="Navigate_Click"/><Button x:Name="PrepareNav" Content="02  设备与阻抗" Style="{StaticResource Nav}" Click="Navigate_Click"/><Button x:Name="RunNav" Content="03  实验运行" Style="{StaticResource Nav}" Click="Navigate_Click"/><Button x:Name="RecordsNav" Content="04  实验记录" Style="{StaticResource Nav}" Click="Navigate_Click"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,24,30,20">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18"><TextBlock x:Name="PageTitle" Text="刺激内容" FontSize="25" FontWeight="SemiBold"/><Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#E1EBE9" CornerRadius="12" Padding="12,6"><TextBlock x:Name="ConnectionLabel" Text="设备未连接" FontSize="12" Foreground="#23685D"/></Border></DockPanel>
   <Border x:Name="NoticePanel" Grid.Row="1" Background="#FFF1D6" CornerRadius="6" Padding="12" Margin="0,0,0,14" Visibility="Collapsed"><TextBlock x:Name="NoticeLabel" Foreground="#805515"/></Border>
   <Grid x:Name="EditorPage" Grid.Row="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="LoadButton" Content="载入方案" Click="Load_Click"/><Button x:Name="SaveButton" Content="保存方案" Style="{StaticResource Primary}" Click="Save_Click"/></StackPanel><TextBox x:Name="SchemeName" Text="六目标基础实验" MaxLength="80" Margin="0,0,18,0"/></DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Background="White" CornerRadius="10" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="选择目标" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <ListBox x:Name="TargetList" DisplayMemberPath="Name" SelectionChanged="Target_Changed" Height="157" BorderBrush="#DFE5EC"/>
      <TextBlock Text="目标名称" Margin="0,16,0,6"/><TextBox x:Name="TargetName" MaxLength="80"/>
      <TextBlock Text="内容类型" Margin="0,14,0,6"/><ComboBox x:Name="KindCombo" SelectionChanged="Kind_Changed"><ComboBoxItem Content="文字"/><ComboBoxItem Content="图形"/><ComboBoxItem Content="图像"/></ComboBox>
      <StackPanel x:Name="TextFields"><TextBlock Text="显示文字" Margin="0,14,0,6"/><TextBox x:Name="TargetText" MaxLength="120" Height="76" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel>
      <StackPanel x:Name="ShapeFields" Visibility="Collapsed"><TextBlock Text="图形" Margin="0,14,0,6"/><ComboBox x:Name="ShapeCombo"><ComboBoxItem Content="矩形"/><ComboBoxItem Content="圆形"/><ComboBoxItem Content="菱形"/><ComboBoxItem Content="箭头"/></ComboBox></StackPanel>
      <StackPanel x:Name="ImageFields" Visibility="Collapsed"><Button Content="选择 PNG / JPEG 图片" Margin="0,14,0,0" Click="Image_Click"/><TextBlock x:Name="ImageLabel" Text="尚未选择图片" FontSize="12" Foreground="#627087" Margin="0,8,0,0"/></StackPanel>
      <Button x:Name="ApplyButton" Content="应用到目标" Style="{StaticResource Primary}" Margin="0,18,0,0" Click="Apply_Click"/>
     </StackPanel></ScrollViewer></Border>
     <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="静态预览" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <Border Grid.Row="1" CornerRadius="10" ClipToBounds="True"><local:StudioStimulusView x:Name="EditorPreview"/></Border>
      <TextBlock Grid.Row="2" Text="六个位置固定，可分别设置文字、图形或图像。保存的方案包含图片素材，可在其他电脑载入。" FontSize="12" Foreground="#66788B" Margin="0,12,0,0"/>
     </Grid>
    </Grid>
   </Grid>
   <ScrollViewer x:Name="PreparePage" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="White" CornerRadius="10" Padding="22"><StackPanel>
     <TextBlock Text="连接脑电设备" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ComboBox x:Name="SourceCombo" SelectedIndex="0"><ComboBoxItem Content="真实脑电设备"/><ComboBoxItem Content="模拟脑电演示"/></ComboBox>
      <TextBox x:Name="DeviceAddress" Grid.Column="1" Margin="12,0" ToolTip="设备地址，可留空自动搜索"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal"><Button x:Name="ConnectButton" Content="连接" Style="{StaticResource Primary}" Click="Connect_Click"/><Button x:Name="DisconnectButton" Content="断开" Click="Disconnect_Click"/></StackPanel>
     </Grid><TextBlock Text="设备地址可留空自动搜索。模拟模式用于功能演示，不代表真实脑电测量。" FontSize="12" Foreground="#66788B" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <Grid Grid.Row="1" Margin="0,24,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="通道阻抗与佩戴检查" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ContactLabel" Grid.Column="1" TextAlignment="Right" Foreground="#66788B" FontSize="12" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="18"><Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,18,0">
       <TextBlock Text="10–20 电极位置图" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="俯视 · 左右为受试者方向 · 点击电极选择通道" Foreground="#66788B" FontSize="11" Margin="0,6,0,12"/>
       <WrapPanel><CheckBox x:Name="EditLocations" Content="设置电极位置" Checked="MapOptions_Changed" Unchecked="MapOptions_Changed" Margin="0,0,14,10"/>
        <CheckBox x:Name="ShowExtended" Content="显示 10–10 扩展位置" IsChecked="True" Checked="MapOptions_Changed" Unchecked="MapOptions_Changed" Margin="0,0,0,10"/></WrapPanel>
       <StackPanel x:Name="BindingToolbar" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8"><TextBlock Text="当前通道" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="BindingChannel" Width="155"/><TextBlock Text=" → 点击图中位置" FontSize="11" VerticalAlignment="Center"/></StackPanel>
       <local:StudioHeadMap x:Name="HeadMap" MaxHeight="400"/>
       <TextBlock Foreground="#66788B" FontSize="11" Margin="0,8,0,0"><Run Text="绿色边框：已选通道　"/><Run Text="● " Foreground="#249C86"/><Run Text="正常　"/><Run Text="● " Foreground="#D98A25"/><Run Text="需调整　"/><Run Text="● " Foreground="#A6B3C0"/><Run Text="未测量"/></TextBlock>
      </StackPanel>
      <Border Grid.Column="1" BorderBrush="#E2E8EE" BorderThickness="1,0,0,0" Padding="16,0,0,0"><StackPanel>
       <TextBlock x:Name="SelectionCount" FontSize="17" FontWeight="SemiBold"/>
       <TextBlock Text="按脑电帽接线设置位置；勾选用于识别的 8 个通道。" Foreground="#66788B" FontSize="11" Margin="0,6,0,12"/>
       <ScrollViewer VerticalScrollBarVisibility="Auto" Height="400" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ImpedanceCards"/></ScrollViewer>
      </StackPanel></Border>
     </Grid>
     <TextBlock x:Name="MappingHint" Grid.Row="1" Foreground="#66788B" FontSize="12" Margin="0,16,0,0"/>
     <TextBlock x:Name="ImpedanceTimeLabel" Grid.Row="2" Foreground="#66788B" FontSize="11" Margin="0,8,0,0"/>
    </Grid></Border>
   </Grid></ScrollViewer>
   <Grid x:Name="RunPage" Grid.Row="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="StartButton" Content="开始实验" Style="{StaticResource Primary}" Click="Start_Click"/><Button x:Name="PauseButton" Content="暂停" Click="Pause_Click"/><Button x:Name="StopButton" Content="结束实验" Click="Stop_Click"/></StackPanel><TextBlock x:Name="RunStatus" Text="请先连接设备并选择识别通道" VerticalAlignment="Center" MaxWidth="350"/></DockPanel>
    <Border x:Name="SimulationPanel" Grid.Row="1" Background="#FFF1D6" Padding="10" Margin="0,0,0,12" Visibility="Collapsed"><StackPanel Orientation="Horizontal"><TextBlock Text="模拟脑电演示  ·  模拟注视目标" VerticalAlignment="Center" Margin="0,0,16,0"/><ComboBox x:Name="SimulationTargetCombo" Width="160" SelectedIndex="1" SelectionChanged="SimulationTarget_Changed"><ComboBoxItem Content="目标 1"/><ComboBoxItem Content="目标 2"/><ComboBoxItem Content="目标 3"/><ComboBoxItem Content="目标 4"/><ComboBoxItem Content="目标 5"/><ComboBoxItem Content="目标 6"/></ComboBox></StackPanel></Border>
    <Border Grid.Row="2" CornerRadius="10" ClipToBounds="True"><local:StudioStimulusView x:Name="RunStimulus"/></Border>
    <DockPanel Grid.Row="3" Margin="0,12,0,0">
     <Border DockPanel.Dock="Right" Background="#E1EBE9" CornerRadius="6" Padding="12,7" Margin="16,0,0,0" VerticalAlignment="Center"
      ToolTip="最近 1 秒的刺激界面绘制帧率，约每 200 ms 更新。暂停或结束后清空；这是应用绘制统计，不是显示器物理刷新测量。">
      <TextBlock x:Name="FrameRateLabel" Text="实时帧率 -- FPS" Foreground="#23685D" FontSize="13" FontWeight="SemiBold" TextWrapping="NoWrap"/>
     </Border>
     <TextBlock Text="注视一个刺激目标，识别后会在该目标外显示选中框。按 Esc 可立即暂停。" Foreground="#66788B" FontSize="12" VerticalAlignment="Center"/>
    </DockPanel>
   </Grid>
   <Grid x:Name="RecordsPage" Grid.Row="2" Visibility="Collapsed">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="刷新记录" Click="RefreshRecords_Click"/><Button Content="打开记录文件夹" Click="OpenRecord_Click"/></StackPanel><TextBlock Text="每次实验独立保存，模拟与真实数据分别标识。" Foreground="#66788B" VerticalAlignment="Center"/></DockPanel>
    <ListView x:Name="RecordsList" Grid.Row="1" BorderBrush="#DFE5EC"><ListView.View><GridView><GridViewColumn Header="开始时间" DisplayMemberBinding="{Binding Time}" Width="175"/><GridViewColumn Header="方案" DisplayMemberBinding="{Binding Name}" Width="210"/><GridViewColumn Header="数据来源" DisplayMemberBinding="{Binding Source}" Width="140"/><GridViewColumn Header="记录状态" DisplayMemberBinding="{Binding Status}" Width="190"/></GridView></ListView.View></ListView>
    <TextBlock x:Name="RecordsHint" Grid.Row="2" Text="记录包括原始脑电、阻抗、刺激时序、识别结果和会话状态。" Foreground="#66788B" FontSize="12" Margin="0,12,0,0"/>
   </Grid>
   <DockPanel Grid.Row="3" Margin="0,18,0,0">
    <TextBlock x:Name="LossCountLabel" DockPanel.Dock="Right" Text="丢包提示 0 次 · 累计丢样 0 点" Foreground="#66788B" FontSize="12" HorizontalAlignment="Right"
     ToolTip="本次连接的 EEG 丢包提示次数与 SDK 报告的丢样点数。COUNT 的单位是采样点，不是蓝牙包；重新连接后清零。"/>
    <TextBlock Text="SSVEP 实验设计  /  R01" Foreground="#8B98A8" FontSize="11"/>
   </DockPanel>
  </Grid>
 </Grid>
 </Grid>
</Window>
