<Window x:Class="Ssvep.Speller.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ssvep.Speller.App"
        mc:Ignorable="d"
        Title="无训练 SSVEP 拼写器"
        Height="860"
        Width="1320"
        Background="#111827"
        Foreground="#F8FAFC"
        StateChanged="Window_StateChanged"
        KeyDown="Window_KeyDown">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinWidth" Value="92"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinWidth" Value="150"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="4,6,10,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="132"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="NavigationBorder"
                Grid.Column="0"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="0,0,1,0"
                Padding="10">
            <StackPanel>
                <TextBlock Text="SSVEP 拼写"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Margin="4,4,4,18"/>
                <Button x:Name="SettingsNavButton"
                        Content="设置"
                        Click="SettingsNavButton_Click"
                        HorizontalContentAlignment="Left"/>
                <Button x:Name="StimulusNavButton"
                        Content="刺激"
                        Click="StimulusNavButton_Click"
                        HorizontalContentAlignment="Left"/>
            </StackPanel>
        </Border>

        <Grid x:Name="SettingsPage"
              Grid.Column="1"
              Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="设置"
                       FontSize="26"
                       FontWeight="SemiBold"
                       Margin="0,0,0,14"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="#1F2937"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="设备连接" FontSize="17" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,10,0,0">
                                <ComboBox x:Name="SourceComboBox" SelectionChanged="SourceComboBox_SelectionChanged">
                                    <ComboBoxItem Content="模拟脑电"/>
                                    <ComboBoxItem Content="Synchroni 设备"/>
                                </ComboBox>
                                <Button x:Name="SearchDeviceButton"
                                        Content="搜索设备"
                                        Click="SearchDeviceButton_Click"/>
                                <ComboBox x:Name="DeviceComboBox"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="DeviceComboBox_SelectionChanged"
                                          MinWidth="260"/>
                                <Button x:Name="ConnectDeviceButton"
                                        Content="连接"
                                        Click="ConnectDeviceButton_Click"/>
                                <Button x:Name="DisconnectDeviceButton"
                                        Content="断开"
                                        Click="DisconnectDeviceButton_Click"
                                        IsEnabled="False"/>
                            </WrapPanel>
                            <TextBlock x:Name="DiagnosticModeTextBlock" Text="模式：模拟脑电" Margin="0,10,0,0"/>
                            <TextBlock x:Name="DiagnosticDeviceTextBlock" Text="设备：-" Margin="0,5,0,0"/>
                            <TextBlock x:Name="DiagnosticRateTextBlock" Text="脑电：250 Hz，8 通道" Margin="0,5,0,0"/>
                            <TextBlock x:Name="DiagnosticSamplesTextBlock" Text="样本：0 / 丢包：0" Margin="0,5,0,0"/>
                            <TextBlock x:Name="DiagnosticBufferTextBlock" Text="缓冲：0 / 625" Margin="0,5,0,0"/>
                            <TextBlock x:Name="DiagnosticLastSampleTextBlock" Text="最新样本：-" Margin="0,5,0,0"/>
                            <TextBlock x:Name="DiagnosticMessageTextBlock" Text="消息：-" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1F2937"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="数据采集模式" FontSize="17" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="运行模式：" Margin="0,0,6,0"/>
                                <ComboBox x:Name="RunModeComboBox"
                                          SelectionChanged="RunModeComboBox_SelectionChanged"
                                          MinWidth="150">
                                    <ComboBoxItem Content="打字闭环"/>
                                    <ComboBoxItem Content="数据采集"/>
                                </ComboBox>
                                <TextBlock Text="重复次数：" Margin="14,0,6,0"/>
                                <TextBox x:Name="CollectionRepeatsTextBox"
                                         Text="5"
                                         Width="56"
                                         Margin="4"
                                         Padding="8,5"/>
                                <TextBlock Text="随机种子：" Margin="14,0,6,0"/>
                                <TextBox x:Name="CollectionSeedTextBox"
                                         Text="20260623"
                                         Width="96"
                                         Margin="4"
                                         Padding="8,5"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="时长 Rest/Cue/Stim/Feedback/ITI 秒：" Margin="0,0,6,0"/>
                                <TextBox x:Name="CollectionRestTextBox" Text="1.0" Width="54" Margin="4" Padding="8,5"/>
                                <TextBox x:Name="CollectionCueTextBox" Text="0.8" Width="54" Margin="4" Padding="8,5"/>
                                <TextBox x:Name="CollectionStimulusTextBox" Text="2.5" Width="54" Margin="4" Padding="8,5"/>
                                <TextBox x:Name="CollectionFeedbackTextBox" Text="0.6" Width="54" Margin="4" Padding="8,5"/>
                                <TextBox x:Name="CollectionInterTrialTextBox" Text="0.8" Width="54" Margin="4" Padding="8,5"/>
                                <Button Content="默认 8 目标"
                                        Click="CollectionDefaultTargetsButton_Click"
                                        MinWidth="110"/>
                                <Button Content="全部 40 目标"
                                        Click="CollectionAllTargetsButton_Click"
                                        MinWidth="110"/>
                            </WrapPanel>
                            <TextBlock x:Name="CollectionTargetStatusTextBlock"
                                       Text="采集目标：默认 8 个"
                                       Foreground="#CBD5E1"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,6"/>
                            <ScrollViewer Height="124" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="CollectionTargetPanel"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="#1F2937"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="反馈模式筛选" FontSize="17" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,10,0,0">
                                <TextBlock Text="打字反馈：" Margin="0,0,6,0"/>
                                <ComboBox x:Name="TypingFeedbackModeComboBox"
                                          SelectionChanged="TypingFeedbackModeComboBox_SelectionChanged"
                                          MinWidth="130">
                                    <ComboBoxItem Content="真反馈"/>
                                    <ComboBoxItem Content="假反馈"/>
                                </ComboBox>
                                <TextBlock Text="打字假反馈目标：" Margin="14,0,6,0"/>
                                <ComboBox x:Name="TypingShamTargetComboBox"
                                          DisplayMemberPath="Label"
                                          MinWidth="130"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="采集反馈：" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CollectionFeedbackModeComboBox"
                                          SelectionChanged="CollectionFeedbackModeComboBox_SelectionChanged"
                                          MinWidth="130">
                                    <ComboBoxItem Content="真反馈"/>
                                    <ComboBoxItem Content="假反馈"/>
                                    <ComboBoxItem Content="混合"/>
                                </ComboBox>
                                <TextBlock Text="混合假反馈比例：" Margin="14,0,6,0"/>
                                <TextBox x:Name="CollectionShamTrialRatioTextBox"
                                         Text="0.5"
                                         Width="56"
                                         Margin="4"
                                         Padding="8,5"/>
                                <TextBlock Text="假反馈命中比例：" Margin="14,0,6,0"/>
                                <TextBox x:Name="CollectionShamPositiveRatioTextBox"
                                         Text="0.5"
                                         Width="56"
                                         Margin="4"
                                         Padding="8,5"/>
                            </WrapPanel>
                            <TextBlock x:Name="FeedbackModeStatusTextBlock"
                                       Text="反馈：打字真反馈；采集假反馈"
                                       Foreground="#CBD5E1"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#1F2937"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="通道筛选" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ChannelFilterStatusTextBlock"
                                       Text="已选择通道 1-8"
                                       TextWrapping="Wrap"
                                       Foreground="#A7F3D0"
                                       Margin="0,8,0,8"/>
                            <ScrollViewer Height="118" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="ChannelFilterPanel"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Background="#1F2937"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="阈值设置" FontSize="17" FontWeight="SemiBold"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="最大阻抗"/>
                                <Slider x:Name="ImpedanceThresholdSlider"
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Minimum="50"
                                        Maximum="1500"
                                        TickFrequency="50"
                                        IsSnapToTickEnabled="True"
                                        Value="500"
                                        ValueChanged="ImpedanceThresholdSlider_ValueChanged"/>
                                <TextBlock x:Name="ImpedanceThresholdValueTextBlock"
                                           Grid.Row="0"
                                           Grid.Column="2"
                                           Text="500 千欧"/>

                                <TextBlock Grid.Row="1" Text="最小得分"/>
                                <Slider x:Name="ScoreThresholdSlider"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Minimum="0.10"
                                        Maximum="1.50"
                                        TickFrequency="0.01"
                                        Value="0.55"
                                        ValueChanged="ScoreThresholdSlider_ValueChanged"/>
                                <TextBlock x:Name="ScoreThresholdValueTextBlock"
                                           Grid.Row="1"
                                           Grid.Column="2"
                                           Text="0.55"/>

                                <TextBlock Grid.Row="2" Text="最小分差"/>
                                <Slider x:Name="MarginThresholdSlider"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Minimum="0.01"
                                        Maximum="0.50"
                                        TickFrequency="0.01"
                                        Value="0.08"
                                        ValueChanged="MarginThresholdSlider_ValueChanged"/>
                                <TextBlock x:Name="MarginThresholdValueTextBlock"
                                           Grid.Row="2"
                                           Grid.Column="2"
                                           Text="0.08"/>

                                <TextBlock Grid.Row="3" Text="连续窗口"/>
                                <ComboBox x:Name="ConsistentWindowsComboBox"
                                          Grid.Row="3"
                                          Grid.Column="1"
                                          SelectionChanged="ConsistentWindowsComboBox_SelectionChanged"
                                          HorizontalAlignment="Left"
                                          MinWidth="90">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                </ComboBox>
                            </Grid>
                            <WrapPanel Margin="0,8,0,0">
                                <TextBlock Text="模拟注视目标：" Margin="0,0,6,0"/>
                                <ComboBox x:Name="FocusComboBox" DisplayMemberPath="Label"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#1F2937"
                            BorderBrush="#334155"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="阻抗检测" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="良好 &lt;=500 千欧；警告 &lt;=999 千欧；较差 &gt;999 千欧"
                                       FontSize="12"
                                       Foreground="#CBD5E1"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,8"/>
                            <ScrollViewer Height="154" VerticalScrollBarVisibility="Auto">
                                <WrapPanel x:Name="ImpedancePanel"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="StimulusPage"
              Grid.Column="1"
              Visibility="Collapsed"
              Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="StimulusToolbar" Grid.Row="0" LastChildFill="True" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="StartButton" Content="开始刺激" Click="StartButton_Click"/>
                    <Button x:Name="StopButton" Content="停止刺激" Click="StopButton_Click" IsEnabled="False"/>
                    <Button x:Name="StyleButton" Content="棋盘格" Click="StyleButton_Click"/>
                    <Button Content="全屏" Click="FullscreenButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="FrameStatsTextBlock" Text="刷新率：-" Margin="10,0,0,0"/>
                </StackPanel>
                <TextBlock x:Name="StimulusReadyTextBlock"
                           Text="刺激就绪：-"
                           TextTrimming="CharacterEllipsis"
                           Margin="10,0,12,0"/>
            </DockPanel>

            <Grid x:Name="StimulusStatusPanel" Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="OutputTextBox"
                         FontFamily="Consolas"
                         FontSize="24"
                         Height="58"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="#F8FAFC"
                         Foreground="#111827"
                         Padding="10"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="StatusTextBlock" Text="空闲" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ClassifierTextBlock" Text="FBCCA，2.5 秒窗口，0.25 秒步长" Margin="0,6,0,0"/>
                    <TextBlock x:Name="FrequencyTextBlock" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    <TextBlock x:Name="CollectionStatusTextBlock" Text="采集：未开始" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <Border x:Name="StimulusCanvasBorder"
                    Grid.Row="2"
                    Background="#020617"
                    BorderBrush="#334155"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4">
                <local:StimulusCanvas x:Name="StimulusCanvas"/>
            </Border>
        </Grid>
    </Grid>
</Window>
